# Copy this file to ".env" (same folder as server.js) and fill in the values.

# PostgreSQL connection string (required).
DATABASE_URL=postgresql://mathfarm:changeme@localhost:5432/mathfarm

# Secret needed once, by the grown-up who starts a friend group (at least 12 characters).
HOST_KEY=change-me

# Port and address the server listens on.
PORT=8080
HOST=127.0.0.1

# How many proxies are in front of this server: 0 = none, 1 = nginx/Caddy, 2 = Cloudflare + nginx.
TRUST_PROXY=1
TRUSTED_PROXIES=127.0.0.1

# Where the game files are (the "site" folder of the package).
SITE_DIR=../site

# Chat messages older than this many days are deleted automatically.
CHAT_RETENTION_DAYS=180

# Players per friend group.
MAX_GROUP_SIZE=40

# Children who may wait for the host's "yes" at the same time, per group.
MAX_WAITING=10

# Requests per minute from one internet address.
RATE_LIMIT_PER_MINUTE=600

# Wrong invite codes allowed per address per 15 minutes.
WRONG_CODE_LIMIT=12

# Time zone for the weekly leaderboard, in minutes from UTC (Jakarta = 420).
WEEK_TZ_OFFSET_MINUTES=420

# 1 = ask search engines not to index the site.
NOINDEX=1

# 1 = send Strict-Transport-Security.
HSTS=0

# 1 = print one line per API request.
LOG_REQUESTS=0
