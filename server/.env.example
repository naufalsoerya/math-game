# Copy this file to ".env" (same folder as server.js) and fill in the values.

# Secret needed once, by the grown-up who starts a friend group (at least 12 characters).
# Give it only to that grown-up. Leave empty to switch off starting new groups.
# The placeholder below is refused on purpose: replace it with your own secret.
HOST_KEY=change-me

# Port and address the server listens on. Keep 127.0.0.1 when nginx/Apache/Caddy on the same machine
# forwards to it (recommended). Use 0.0.0.0 only inside Docker or when nothing else is in front.
PORT=8080
HOST=127.0.0.1

# How many proxies are in front of this server: 0 = none, 1 = nginx/Apache/Caddy,
# 2 = Cloudflare (or a load balancer) + nginx. Used to find the real visitor address for rate limits.
TRUST_PROXY=1
# Optional: exact proxy addresses (comma separated) whose X-Forwarded-For header is believed.
# 127.0.0.1 = only a proxy on this machine (recommended). Empty = this machine or any private network address (Docker sets this).
TRUSTED_PROXIES=127.0.0.1

# Where the database is kept (relative to this folder). Back this folder up.
DATA_DIR=data

# Where the game files are (the "site" folder of the package).
SITE_DIR=../site

# Chat messages older than this many days are deleted automatically.
CHAT_RETENTION_DAYS=180

# Players per friend group (a school class fits in 40).
MAX_GROUP_SIZE=40

# Children who may wait for the host's "yes" at the same time, per group (raise to 40 when a whole class joins at once).
MAX_WAITING=10

# Requests per minute from one internet address. A school or office where many children share one address
# needs more: a child uses about 7 requests a minute on average and up to 20 with the chat open,
# so allow 20 per child playing at the same time (e.g. 3000 for 150 children).
RATE_LIMIT_PER_MINUTE=600

# Wrong invite codes allowed from one internet address per 15 minutes (protects the codes from guessing).
WRONG_CODE_LIMIT=12

# Time zone for the weekly leaderboard, in minutes from UTC (Jakarta = 420).
WEEK_TZ_OFFSET_MINUTES=420

# 1 = ask search engines not to index the site (recommended for a family game).
NOINDEX=1

# 1 = send Strict-Transport-Security (only when the site is always served over HTTPS).
HSTS=0

# 1 = print one line per API request (no chat content is logged).
LOG_REQUESTS=0
