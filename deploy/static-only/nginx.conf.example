# Example nginx server block for Adley's Math Farm (static files only, no backend).
# Copy the CONTENTS of the "site" folder to the web root below.
#   1) Copy the CONTENTS of the "site" folder to the web root below.
#   2) Copy mathfarm-headers.conf to /etc/nginx/snippets/mathfarm-headers.conf
#   3) nginx -t && systemctl reload nginx
server {
    listen 443 ssl;
    http2 on;                                    # nginx >= 1.25.1; on older nginx write "listen 443 ssl http2;" instead
    server_name mathfarm.example.com;            # <- change
    ssl_certificate     /etc/ssl/certs/mathfarm.crt;     # <- your TLS certificate
    ssl_certificate_key /etc/ssl/private/mathfarm.key;   # <- your TLS key

    root /var/www/adley-math-farm;               # <- folder that contains index.html
    index index.html;
    charset utf-8;
    charset_types text/css application/javascript application/manifest+json text/plain;

    include /etc/nginx/mime.types;
    # .webmanifest is missing from older mime.types files
    types { application/manifest+json webmanifest; }

    gzip on;
    gzip_types text/css application/javascript application/manifest+json text/plain;

    location = /index.html {
        include snippets/mathfarm-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
    location ~* \.(js|css|woff2)$ {
        include snippets/mathfarm-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
    location ~* \.png$ {
        include snippets/mathfarm-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
    }
    location ~ /\. { deny all; }                # never serve .htaccess or other dot-files
    location / {
        include snippets/mathfarm-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ =404;
    }
}
server {
    listen 80;
    server_name mathfarm.example.com;            # <- change
    return 301 https://$host$request_uri;
}
