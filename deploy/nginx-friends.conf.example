# nginx in front of the friends server (recommended set-up).
# nginx handles HTTPS and forwards everything to the Node server, which serves the game files AND the /api.
#   - Keep TRUST_PROXY=1 in server/.env (2 if Cloudflare is also in front).
#   - nginx -t && systemctl reload nginx
server {
    listen 443 ssl;
    http2 on;                                    # nginx >= 1.25.1; on older nginx write "listen 443 ssl http2;" instead
    server_name mathfarm.example.com;            # <- change
    ssl_certificate     /etc/ssl/certs/mathfarm.crt;     # <- your TLS certificate
    ssl_certificate_key /etc/ssl/private/mathfarm.key;   # <- your TLS key

    client_max_body_size 100k;                   # the game only sends small JSON requests
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
server {
    listen 80;
    server_name mathfarm.example.com;            # <- change
    return 301 https://$host$request_uri;
}
# The game in a sub-folder instead (https://example.com/mathfarm/): use
#     location /mathfarm/ { proxy_pass http://127.0.0.1:8080/; ...same proxy_set_header lines... }
# The trailing slashes matter: they remove "/mathfarm" before the request reaches the Node server.
